  "vocabularies": {
    "note": [
      "The field's own vocabularies, and what each of their components is in the",
      "system's terms. The gnu6-design package carries the g6-* vocabulary, which",
      "the field uses and the system does not declare. This is the translation.",
      "",
      "Three kinds of entry, and the difference matters:",
      "",
      "  a component  the system's own element, under its canonical name",
      "  a pattern    a composition the system states but does not declare as an",
      "               element, because it is an arrangement rather than a thing",
      "  a primitive  a thing the system's type, spacing or accessibility tier",
      "               governs, with no component of its own",
      "",
      "The mapping is checked against the package: a name the package declares and",
      "the contract does not classify is a failure, so the two cannot drift."
    ],
    "gnu6-design": {
      "package": "gnu6-design",
      "prefix": "g6-",
      "components": {
        "action": {
          "is": "component",
          "target": "button",
          "note": "The control a person presses. The g6 action carries the same four variants the system declares: quiet, portal, disabled and busy."
        },
        "brand": {
          "is": "pattern",
          "note": "The mark and the name of a product. The identity is the system's ratified artwork; the lockup is a composition of it."
        },
        "dia": {
          "is": "pattern",
          "note": "A diagram. The system's own content, carried by the system's canvas and type."
        },
        "display": {
          "is": "primitive",
          "note": "The display type. Governed by the system's type tier."
        },
        "doc": {
          "is": "pattern",
          "note": "A document region: prose with its own rules. A composition of the system's type and spacing."
        },
        "empty": {
          "is": "pattern",
          "note": "The state of a surface that has nothing in it yet. A composition of the system's type and spacing."
        },
        "enter": {
          "is": "primitive",
          "note": "The staggered entrance of a group's children. Governed by the system's motion tier, which states the meaning of motion and the reduced-motion equivalence; it is not a component."
        },
        "ext": {
          "is": "pattern",
          "note": "A link out of the surface. The system's link semantics apply."
        },
        "facts": {
          "is": "pattern",
          "note": "The facts of a claim, set out. A composition of the system's evidence semantics."
        },
        "figure": {
          "is": "pattern",
          "note": "A figure with its caption. A composition of the system's spacing and type."
        },
        "files": {
          "is": "pattern",
          "note": "A list of files. A composition of the system's card and the tabular numerals."
        },
        "footer": {
          "is": "pattern",
          "note": "The end of a surface: the links and the credit. A composition of the system's navigation semantics and type."
        },
        "frame": {
          "is": "pattern",
          "note": "The bounded region a surface sets its content in. A composition of the system's card and spacing."
        },
        "goto": {
          "is": "pattern",
          "note": "A jump to a named place. A composition of the system's navigation semantics and focus."
        },
        "hero": {
          "is": "pattern",
          "note": "The opening block of a surface: the title, the words and the actions. A composition of the system's display type, section-heading and button."
        },
        "label": {
          "is": "primitive",
          "note": "A small label. Governed by the system's type tier."
        },
        "lang": {
          "is": "pattern",
          "note": "The language switch. A composition of the system's select."
        },
        "lede": {
          "is": "primitive",
          "note": "The standfirst under a title. Governed by the system's type tier."
        },
        "ledger": {
          "is": "pattern",
          "note": "A ledger of facts, with the values aligned. A composition of the system's card and the tabular numerals."
        },
        "masthead": {
          "is": "pattern",
          "note": "The identity block of a surface: the mark, the name, and the words beside them. A composition of the system's identity and section-heading."
        },
        "menu": {
          "is": "pattern",
          "note": "A menu: a list of choices that opens over the surface. The system declares the choice semantics; the menu is a composition of them."
        },
        "menu-anchor": {
          "is": "pattern",
          "note": "The element a menu opens from. The system's own focus and selection rules apply to it."
        },
        "notice": {
          "is": "pattern",
          "note": "A notice: a condition that asks for attention. The system's badge carries the condition; the notice is the surface it sits on."
        },
        "num": {
          "is": "primitive",
          "note": "A number, aligned with the others. Governed by the system's type tier and its tabular figures."
        },
        "page": {
          "is": "pattern",
          "note": "The frame of a page. A composition of the system's layout, not an element of its own."
        },
        "prose": {
          "is": "pattern",
          "note": "A run of reading text. Governed by the system's type tier and its measure, not by a component."
        },
        "rail": {
          "is": "pattern",
          "note": "The navigation rail of a surface: a column of the sections, with the active one marked. A composition of the system's card, badge and section-heading."
        },
        "record": {
          "is": "pattern",
          "note": "One record in a ledger. A composition of the system's card and badge."
        },
        "section": {
          "is": "component",
          "target": "section-heading",
          "note": "The heading of a section, with the number that says where the section sits."
        },
        "skip": {
          "is": "primitive",
          "note": "The link that skips to the content. Governed by the system's accessibility rules."
        },
        "specimen": {
          "is": "pattern",
          "note": "A specimen: a thing shown with its own description. A composition of the system's card, figure and badge."
        },
        "state": {
          "is": "component",
          "target": "badge",
          "note": "A short mark that says what a thing is. The g6 state carries the same five conditions the system declares: stable, attention, breach, empty and planned."
        },
        "study": {
          "is": "pattern",
          "note": "A study unit: the chapters and the exercises. A composition of the system's card and section-heading."
        },
        "sysbar": {
          "is": "pattern",
          "note": "The system bar at the top of a surface: the identity, the status and the language. A composition, not an element."
        },
        "sysmenu": {
          "is": "pattern",
          "note": "The menu the system bar opens. A composition of the system's card and menu semantics."
        },
        "sysnav": {
          "is": "pattern",
          "note": "The navigation inside the system bar. A composition of the system's section-heading and toggle."
        },
        "toc": {
          "is": "pattern",
          "note": "The table of contents. A composition of the system's navigation semantics."
        },
        "toc-inline": {
          "is": "pattern",
          "note": "The table of contents, inline with the text. A composition of the system's navigation semantics."
        },
        "visually-hidden": {
          "is": "primitive",
          "note": "Text a screen reader carries and a screen does not show. Governed by the system's accessibility rules."
        }
      }
    }
  }
}
